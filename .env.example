# Example DATABASE_URL for PostgreSQL (do NOT commit real credentials)
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Local sqlite path (optional, used when DATABASE_URL is not set)
SQLITE_DB_PATH=app.db

# Optional: PORT used by hosting providers (Railway sets this automatically)
PORT=5000

# Login PINs (change these in production)
SELLER_PIN=1111
MANAGER_PIN=1991

# Flask session signing key (use a long random value in production)
SECRET_KEY=change-this-secret
